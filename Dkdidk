local function rnd(base, spread)
    if not CONFIG.Humanize then return base end
    local v = base + math.random(-math.floor(spread*10), math.floor(spread*10)) / 10
    if v < 0.2 then v = 0.2 end
    return v
end

local function fmtT(sec)
    if not sec or sec <= 0 then return "0د" end
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    if h > 0 then return h .. "س " .. m .. "د" end
    return m .. "د"
end

local function formatClockTime(seconds)
    local s = seconds % 60
    local m = (seconds // 60) % 60
    local h = (seconds // 3600) % 24
    return string.format("%02d:%02d:%02d", h, m, s)
end

