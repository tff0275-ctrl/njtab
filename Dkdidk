local function hasTool()
    local function chk(n)
        local x = tostring(n):lower()
        local isLockpick = x:find("فاتح اقفال") or x:find("فاتح أقفال")
                        or x:find("lockpick") or x:find("lock pick")
        local isAdvanced = x:find("متقدم") or x:find("advanced") or x:find("advance")
        return isLockpick and not isAdvanced
    end
    local char = LP.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and chk(t.Name) then return t end
        end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and chk(t.Name) then return t end
        end
    end
    return nil
end

local function getPromptPos(p)
    local parent = p.Parent
    if not parent then return nil end
    if parent:IsA("BasePart") then return parent.Position end
    local part = parent:FindFirstChildWhichIsA("BasePart")
    if part then return part.Position end
    if parent.Parent then
        local sib = parent.Parent:FindFirstChild("MainCashier")
        if sib and sib:IsA("BasePart") then return sib.Position end
    end
    return nil
end

local function findClosestPromptTo(targetPos)
    local best, bestDist = nil, 999999

    for p in pairs(promptCache) do
        if p.Parent then
            local pos = getPromptPos(p)
            if pos then
                local d = (pos - targetPos).Magnitude
                if d < bestDist then bestDist = d; best = p end
            end
        end
    end

    if not best or bestDist > CONFIG.ButtonRadius then
        local ok, list = pcall(function() return workspace:GetDescendants() end)
        if ok and list then
            for _, p in ipairs(list) do
                if p:IsA("ProximityPrompt") and p.Parent then
                    local pos = getPromptPos(p)
                    if pos then
                        local d = (pos - targetPos).Magnitude
                        if d < bestDist then bestDist = d; best = p end
                    end
                end
            end
        end
    end

    if best and bestDist <= CONFIG.ButtonRadius then return best end
    return nil
end

local function buttonExists(targetPos)
    local p = findClosestPromptTo(targetPos)
    if p and p.Enabled then return true, p end
    return false, nil
end

