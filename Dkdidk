local function normalizeKey(k)
    local s = tostring(k or "")
    s = s:gsub("\226\128\139", ""):gsub("\226\128\140", "")
    s = s:gsub("\226\128\141", ""):gsub("\239\187\191", "")
    s = s:gsub("\217[\128-\191]", "")
    s = s:gsub("%s", "")
    return s
end

