local function validateKey(rawInput)
    if not rawInput or rawInput == "" then return false, "الرجاء إدخال مفتاح", nil end
    local inputKey = normalizeKey(rawInput)
    if inputKey == "" then return false, "الرجاء إدخال مفتاح", nil end

    local entry = KEYS[inputKey]
    local isMaster = (entry ~= nil) and ((tonumber(entry.hours) or 0) <= 0)

    if isMaster and isKeyBlacklisted(inputKey) then
        blacklistedKeys[inputKey] = nil
        saveBlacklist()
    end

    if not entry then
        if isKeyBlacklisted(inputKey) then
            return false, "❌ هذا المفتاح محظور نهائياً.", nil
        end
        if isUserBanned() then
            return false, "🚫 أنت محظور.\n🔓 فقط مفتاح دائم يفك الحظر.", nil
        end
        local count = incrementWrongCount()
        if count >= MAX_WRONG_ATTEMPTS then
            banUser("3 محاولات مفتاح خاطئة")
            return false, "🚫 تم حظرك بعد " .. MAX_WRONG_ATTEMPTS .. " محاولات خاطئة!", nil
        end
        return false, "❌ المفتاح غير صحيح\n⚠️ محاولات متبقية: " .. (MAX_WRONG_ATTEMPTS - count), nil
    end

    local reqId = tonumber(entry.userId) or 0
    if reqId ~= 0 and reqId ~= LP.UserId then
        return false, "❌ هذا المفتاح لا يخص حسابك.", nil
    end

    local duration = tonumber(entry.hours) or 0

    if duration <= 0 then
        unbanUser(inputKey)
        resetWrongCount()
        bindKeyToUser(inputKey, LP.UserId)
        return true, "مفتاح دائم ♾️", 0
    end

    if isKeyBlacklisted(inputKey) then
        return false, "❌ هذا المفتاح انتهى وحُظر نهائياً.", nil
    end
    local existingBind = getKeyBinding(inputKey)
    if existingBind and existingBind ~= "0" and existingBind ~= tostring(LP.UserId) then
        return false, "❌ هذا المفتاح مربوط بمستخدم آخر.", nil
    end
    if isUserBanned() then
        return false, "🚫 أنت محظور.", nil
    end
    if not existingBind then bindKeyToUser(inputKey, LP.UserId) end

    local durationSec = duration * 3600
    local startedAt = getStartTime(inputKey)
    if not startedAt then
        startedAt = os.time()
        saveStartTime(inputKey, startedAt)
    end
    local remaining = durationSec - (os.time() - startedAt)
    if remaining <= 0 then
        addToBlacklist(inputKey, "انتهت المدة")
        banUser("انتهاء صلاحية المفتاح")
        return false, "⏰ انتهت مدة المفتاح.", 0
    end
    resetWrongCount()
    return true, "مفتاح فعّال ⏳ " .. fmtT(remaining), remaining
end

