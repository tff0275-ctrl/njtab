local function hopServer()
    setStatus("🌍 ننتقل سيرفر جديد...", Color3.fromRGB(180, 180, 255))
    actionLog.serverHop = actionLog.serverHop + 1
    unfreezeCharacter()
    unlockCamera()
    makeVisible()

    markVisited(game.JobId)

    local loaderCode = 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()'

    local queueFns = {
        queue_on_teleport,
        queueonteleport,
        getgenv and getgenv().queue_on_teleport,
        getgenv and getgenv().queueonteleport,
        syn and syn.queue_on_teleport,
        syn and syn.queueonteleport,
        fluxus and fluxus.queue_on_teleport,
        fluxus and fluxus.queueonteleport,
        Krnl and Krnl.QueueOnTeleport,
    }
    local queueSaved = false
    for _, fn in ipairs(queueFns) do
        if type(fn) == "function" then
            if pcall(fn, loaderCode) then queueSaved = true; break end
        end
    end

    if queueSaved then
        print("[WE SERVER] ✅ queue_on_teleport محفوظ")
        setStatus("🌍 انتقال + سكربت محفوظ ✅", Color3.fromRGB(150, 255, 150))
        task.wait(0.5)
    else
        local savedPaths = {}
        for _, p in ipairs({
            "we_server_loader.lua",
            "autoexec/we_server.lua",
            "AutoExecute/we_server.lua",
            "Delta/autoexec/we_server.lua",
        }) do
            if pcall(writefile, p, loaderCode) then table.insert(savedPaths, p) end
        end

        print("═══════════════════════════════════════════════")
        print("[WE SERVER] ⚠️ إيكسكيوتورك (Delta) ما يدعم queue_on_teleport")
        print("[WE SERVER] 💾 حفظت لودر — فعّل Auto-Execute في Delta")
        for _, f in ipairs(savedPaths) do print("[WE SERVER]    📄 " .. f) end
        print("[WE SERVER] 📋 المحتوى:")
        print(loaderCode)
        print("═══════════════════════════════════════════════")

        setStatus("⚠️ Delta: فعّل Auto-Execute", Color3.fromRGB(255, 150, 100))
        task.wait(2)
    end

    local servers = {}
    for i = 1, 3 do
        local ok, result = pcall(function() return TS:GetPublicServersAsync(game.PlaceId) end)
        if ok and result and #result > 0 then servers = result; break end
        task.wait(1)
    end

    if #servers == 0 then
        pcall(function() TS:Teleport(game.PlaceId) end)
        return
    end

    local currentJob = game.JobId
    local fresh, low, any = {}, {}, {}
    for _, s in ipairs(servers) do
        if s.id ~= currentJob and s.playing < s.maxPlayers then
            if not wasRecent(s.id) then
                if s.playing <= 1 then table.insert(fresh, s)
                elseif s.playing <= 3 then table.insert(low, s)
                else table.insert(any, s) end
            end
        end
    end

    local pick = nil
    if #fresh > 0 then pick = fresh[math.random(1, #fresh)]
    elseif #low > 0 then pick = low[math.random(1, #low)]
    elseif #any > 0 then pick = any[math.random(1, #any)] end

    if pick then
        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, pick.id) end)
    else
        pcall(function() TS:Teleport(game.PlaceId) end)
    end
end

local function countdown(seconds)
    if seconds <= 0 then return true end
    local startT = os.clock()
    while true do
        if stopRequested then return false end
        alive()
        if (os.clock() - startT) >= seconds then break end
        task.wait(0.2)
    end
    return true
end

local function runOneCycle()
    alive()
    local w = 0
    while (not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart")) and not stopRequested do
        task.wait(0.3); w += 0.3
        alive()
        if w > 15 then break end
    end
    if stopRequested then return "stopped" end

    local w2 = 0
    while not promptCacheReady and w2 < 4 and not stopRequested do
        task.wait(0.3); w2 += 0.3
    end

    freezeCharacter()
    makeVisible()
    if not countdown(CONFIG.StartDelay) then return "stopped" end

    local locs = getActiveLocations()
    for i, loc in ipairs(locs) do
        if stopRequested then return "stopped" end
        alive()

        unfreezeCharacter()
        makeVisible()
        currentTargetPos = loc.pos
        teleportHRP(loc.pos + Vector3.new(0, 3, 2) + sessionOffset)
        task.wait(fw(0.5)) -- ⏱️ انتظار أطول للنزول
        freezeCharacter()

        local exists, prompt = buttonExists(loc.pos)
        if not exists then
            actionLog.skipped = actionLog.skipped + 1
            setStatus("⏭️ " .. loc.name .. ": ما فيه زر", Color3.fromRGB(180, 180, 255))
        else
            local busy, who = isLocationBusy(loc.pos)
            if busy then
                actionLog.busy = actionLog.busy + 1
                setStatus("⚠️ مشغول (" .. tostring(who) .. ")", Color3.fromRGB(255, 200, 100))
            else
                local canRob = forceBuyBeforeRob()
                if canRob and hasTool() then
                    local ok = robAt(loc.pos, loc.name, prompt)
                    if ok then
                        return "robbed"
                    end
                end
            end
        end
        makeVisible()

        if not CONFIG.OneRobPerServer and i < #locs then
            if not countdown(CONFIG.WaitBetweenCashiers) then return "stopped" end
        end
    end

    return "empty"
end

local function startWatchdog()
    if watchdogRunning then return end
    watchdogRunning = true
    task.spawn(function()
        while watchdogRunning and not stopRequested do
            task.wait(CONFIG.WatchdogInterval)
            if stopRequested or not watchdogRunning then break end
            if currentMode == MODE_NONE then
                WatchdogValue.Text = "ينتظر"
                WatchdogValue.TextColor3 = Color3.fromRGB(180, 180, 180)
            else
                WatchdogValue.Text = "✅ شغال"
                WatchdogValue.TextColor3 = Color3.fromRGB(150, 255, 150)
            end
        end
        watchdogRunning = false
    end)
end

