        LoopValue.Text = tostring(currentLoop)
        local okc, errc = pcall(runOneCycle)
        if not okc then warn("[CYCLE] " .. tostring(errc)) end
        setStatus("✅ خلصنا", Color3.fromRGB(150, 255, 150))
        currentMode = MODE_NONE
        makeVisible()
    end)
end

startRepeat = function()
    if currentMode ~= MODE_NONE then return end
    currentMode = MODE_REPEAT
    stopRequested = false
    actionLog.repeatStart = true
    setStatus("♻️ تكرار لا نهائي", Color3.fromRGB(200, 160, 255))
    startWatchdog(); startAntiAFK()
    task.spawn(function()
        while not stopRequested do
            alive()
            currentLoop += 1
            LoopValue.Text = tostring(currentLoop)
            local okc, errc = pcall(runOneCycle)
            if not okc then
                actionLog.errors = actionLog.errors + 1
                task.wait(2)
            end
            if not stopRequested then
                if not countdown(CONFIG.WaitBetweenCashiers) then break end
            end
        end
        currentMode = MODE_NONE
        makeVisible()
        setStatus("⏹️ وقفنا", Color3.fromRGB(255, 150, 150))
    end)
end

