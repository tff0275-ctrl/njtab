local function forceCloseMarket()
    local market = PG:FindFirstChild("Market")
    if not market then return end
    local closeBtn = nil
    for _, obj in ipairs(market:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local n = obj.Name:lower()
            if n == "close" or n == "x" or n == "exit" or n == "quit" then
                closeBtn = obj; break
            end
        end
    end
    if closeBtn then
        pcall(function() closeBtn:Activate() end)
        for _, c in pairs(safeGetConnections(closeBtn, "MouseButton1Click")) do
            if c.Function then task.spawn(c.Function) end
        end
    end
    pcall(function() market.Enabled = false end)
    pcall(function() market.Visible = false end)
    task.wait(fw(0.2))
end

local function buy()
    if isBuying then return false end
    isBuying = true
    actionLog.buyCount = actionLog.buyCount + 1
    local deadline = os.clock() + CONFIG.BuyTimeout

    local ok, result = pcall(function()
        setStatus("🛒 شراء سريع...", Color3.fromRGB(255, 180, 100))
        if hasTool() then
            forceCloseMarket()
            return true
        end
        local backPos = nil
        local hrp0 = getHRP()
        if hrp0 then backPos = hrp0.Position end

        local seller = nil
        local mf = workspace:FindFirstChild("MarketFolder")
        if mf then seller = mf:FindFirstChild("SellerNPC") end
        if not seller then seller = workspace:FindFirstChild("SellerNPC", true) end
        if not seller then return false end
        local part = seller:IsA("BasePart") and seller or seller:FindFirstChildWhichIsA("BasePart", true)
        if not part then return false end
        unfreezeCharacter()
        teleportHRP(part.Position + Vector3.new(0, 3, 2.5))
        task.wait(fw(0.4))
        freezeCharacter()
        lockCameraOnButton(part.Position)
        task.wait(fw(0.6))

        local prompt = seller:FindFirstChild("Buy") or seller:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            pcall(function()
                prompt.HoldDuration = 0
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 30
                prompt.Enabled = true
            end)
        end

        local marketOpened = false
        for attempt = 1, 6 do
            if stopRequested or os.clock() > deadline then break end
            alive()
            clickPromptButton()
            if prompt then pcall(function() fireproximityprompt(prompt) end) end
            task.wait(fw(0.35))
            local market = PG:FindFirstChild("Market")
            if market then
                local mf2 = market:FindFirstChild("MainFrame")
                if mf2 and mf2.Visible then marketOpened = true; break end
            end
        end

        if not marketOpened then
            unlockCamera()
            if backPos then teleportHRP(backPos) end
            return false
        end

        unlockCamera()
        task.wait(fw(0.4))

        local market = PG:FindFirstChild("Market")
        local mf2 = market and market:FindFirstChild("MainFrame")
        if not mf2 then if backPos then teleportHRP(backPos) end return false end
        local list = mf2:FindFirstChild("ItemsList")
        if not list then if backPos then teleportHRP(backPos) end return false end

        local target = nil
        for _, item in ipairs(list:GetChildren()) do
            if item:IsA("GuiObject") then
                local txt = ""
                for _, d in ipairs(item:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local t = ""
                        pcall(function() t = d.Text end)
                        if t ~= "" then txt = txt .. " " .. t end
                    end
                end
                local tl = txt:lower()
                local isLockpick = tl:find("فاتح اقفال") or tl:find("فاتح أقفال")
                                or tl:find("lockpick") or tl:find("lock pick")
                local isAdvanced = tl:find("متقدم") or tl:find("advanced") or tl:find("advance")
                if isLockpick and not isAdvanced then target = item; break end
            end
        end
        if not target then if backPos then teleportHRP(backPos) end return false end

        local addBtn = nil
        for _, d in ipairs(target:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and
               (d.Name == "Click" or d.Name == "AddToCart" or d.Name == "Add") then
                addBtn = d; break
            end
        end
        if addBtn then clickGui(addBtn); task.wait(fw(0.6)) end

        local cart = mf2:FindFirstChild("Cart")
        local buyBtn = nil
        if cart then
            local buyFrame = cart:FindFirstChild("Buy")
            if buyFrame then
                buyBtn = buyFrame:FindFirstChild("Click") or buyFrame
            else
                buyBtn = findBtn(cart, {"Click", "Buy"})
            end
        end
        if buyBtn then clickGui(buyBtn); task.wait(fw(0.6)) end

        forceCloseMarket()
        if backPos then teleportHRP(backPos) end
        return hasTool() ~= nil
    end)

    isBuying = false
    if not ok then
        warn("[BUY] خطأ: " .. tostring(result))
        actionLog.errors = actionLog.errors + 1
        return false
    end
    return result
end

local function forceBuyBeforeRob()
    if hasTool() then return true end
    for attempt = 1, CONFIG.BuyAttempts do
        if stopRequested then return false end
        alive()
        setStatus("🛒 شراء (" .. attempt .. "/" .. CONFIG.BuyAttempts .. ")", Color3.fromRGB(255, 180, 100))
        local bought = buy()
        if bought and hasTool() then return true end
        task.wait(fw(0.8))
    end
    return hasTool() ~= nil
end

-- 💰 سرقة محسّنة - بدون Anchor + A/D للميني جيم
local function robAt(targetPos, name, prompt)
    setStatus("💰 نسرق " .. name, Color3.fromRGB(255, 130, 190))
    LocValue.Text = name
    actionLog.robCount = actionLog.robCount + 1
    alive()
    currentTargetPos = targetPos

    -- ✅ نجبر الشخصية تقف
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.Sit = false
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end

    local tool = hasTool()
    if tool and hum then
        pcall(function() hum:EquipTool(tool) end)
    end
    task.wait(fw(0.3))

    freezeCharacter() -- (الآن WalkSpeed=0 بدون Anchor)
    makeInvisible()
    lockCameraOnButton(targetPos)
    task.wait(fw(0.5)) -- انتظار عشان تنزل على الأرض

    local success = false
    local startT = os.clock()
    local attempt = 0
    local keySpamOn = false
    local promptRef = prompt

    -- 🎮 A/D/Space spammer
    if CONFIG.KeySpamEnabled then
        task.spawn(function()
            while true do
                if not keySpamOn or stopRequested then
                    task.wait(0.05)
                else
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.A, false, game)
                        task.wait(CONFIG.KeySpamInterval)
                        VIM:SendKeyEvent(false, Enum.KeyCode.A, false, game)
                    end)
                    if stopRequested or not keySpamOn then continue end
                    task.wait(0.02)
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.D, false, game)
                        task.wait(CONFIG.KeySpamInterval)
                        VIM:SendKeyEvent(false, Enum.KeyCode.D, false, game)
                    end)
                    if stopRequested or not keySpamOn then continue end
                    task.wait(0.02)
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                        task.wait(CONFIG.KeySpamInterval)
                        VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                    end)
                    task.wait(0.02)
                end
            end
        end)
    end

    -- 🎯 3 ضغطات سريعة على الزر
    for b = 1, 3 do
        if stopRequested then break end
        if not hasTool() then break end
        if not promptRef or not promptRef.Parent then break end

        attempt += 1
        alive()
        setStatus("⚡ نضغط " .. name .. " (" .. b .. "/3)", Color3.fromRGB(200, 160, 255))

        if LP.Character then
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if h then
                local t2 = hasTool()
                if t2 then
                    local equipped = h:FindFirstChildOfClass("Tool")
                    if equipped ~= t2 then pcall(function() h:EquipTool(t2) end) end
                end
            end
        end

        if promptRef.Enabled then
            pcall(function() fireproximityprompt(promptRef) end)
            clickPromptButton()
        end
        task.wait(0.05)
    end

    -- 🎮 مرحلة الميني جيم
    local minigameStarted = false
    while (os.clock() - startT) < CONFIG.RobTimeout do
        if stopRequested then break end
        if not hasTool() then break end

        if promptRef and promptRef.Parent and not promptRef.Enabled then
            if not minigameStarted then
                minigameStarted = true
                keySpamOn = true
                setStatus("🎮 ميني جيم " .. name, Color3.fromRGB(255, 220, 100))
            end
        elseif promptRef and promptRef.Parent and promptRef.Enabled then
            if minigameStarted then break end
            setStatus("⚡ نحاول " .. name, Color3.fromRGB(200, 160, 255))
            pcall(function() fireproximityprompt(promptRef) end)
            clickPromptButton()
        elseif not promptRef or not promptRef.Parent then
            break
        end

        task.wait(0.1)
    end

    keySpamOn = false
    task.wait(0.3)

    -- ✅ تحقق
    if hasTool() then
        success = false
    else
        task.wait(0.6)
        if promptRef and promptRef.Parent and promptRef.Enabled then
            setStatus("🔄 نحاول ثاني " .. name, Color3.fromRGB(255, 200, 100))
            for retry = 1, 2 do
                if stopRequested then break end
                if not hasTool() then success = true; break end
                if not promptRef or not promptRef.Parent then success = true; break end
                pcall(function() fireproximityprompt(promptRef) end)
                clickPromptButton()
                task.wait(1.5)
            end
            if not success and (not hasTool() or not promptRef or not promptRef.Parent) then
                success = true
            end
        else
            success = true
        end
    end

    if success then
        setStatus("✅ سرقة تمت!", Color3.fromRGB(150, 255, 150))
        logAction("💰 سرقة ناجحة", name)
    else
        setStatus("⚠️ فشل " .. name, Color3.fromRGB(255, 200, 100))
        actionLog.errors = actionLog.errors + 1
    end

    unlockCamera()
    makeVisible()
    return success
end

